# ==============================================================================
# FlashCart Environment Configuration Template (.env.example)
# Copy this file to .env and supply your local database credentials.
# ==============================================================================

# MySQL Database Host Address (typically localhost or 127.0.0.1)
DB_HOST=localhost

# MySQL Database User (typically root)
DB_USER=root

# MySQL Database Password
DB_PASSWORD=your_mysql_password

# Target Relational Database Name
DB_NAME=flashcart_db

# MySQL Server Port (standard default is 3306)
DB_PORT=3306
