# ==============================================================================
# FlashCart Environment & Security Exclusion Rules (.gitignore)
# ==============================================================================

# 1. Sensitive Environment Files & Database Credentials (CRITICAL)
.env
.env.*
!.env.example
*.local

# 2. Python Bytecode, Caches & Compilations
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# 3. Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# 4. Streamlit & Web Framework Local Caches
.streamlit/
.streamlit/*.toml
!.streamlit/config.toml.example

# 5. IDE & Editor Metadata
.vscode/
.idea/
*.swp
*.swo
*~

# 6. Operating System Specific Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# 7. Local Logs & Dumps
*.log
scratch/
test_audit.py
